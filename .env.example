# Server
NODE_ENV=development
PORT=3000

# PostgreSQL — the only application persistence/rate-limit store
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=mduaradb
DB_POOL_MAX=10

# Initial platform super administrator. npm run migrate requires these values.
# Keep the real password only in .env or deployment secrets, never in source control.
SUPER_ADMIN_FULL_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# JWT session configuration
JWT_SECRET=change_this_to_a_long_random_string_for_dev_only_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP verification and PostgreSQL-backed resend throttling
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60

# Phone/email + password login security
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
BCRYPT_SALT_ROUNDS=12

# Safaricom Daraja M-Pesa configuration
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=your_sandbox_shortcode
MPESA_PASSKEY=your_daraja_passkey
MPESA_CALLBACK_URL=https://your-public-https-host.example.com/api/v1/payments/mpesa/callback
# Dedicated BE-10 subscription STK callback; do not route subscription receipts into contribution processing.
MPESA_SUBSCRIPTION_CALLBACK_URL=https://your-public-https-host.example.com/api/v1/subscriptions/mpesa/callback
MPESA_ENVIRONMENT=sandbox
# Daraja B2C loan-disbursement callbacks (BE-07). Production loan disbursement remains policy-blocked by PD-22.
MPESA_B2C_INITIATOR_NAME=your_b2c_initiator_name
MPESA_B2C_SECURITY_CREDENTIAL=your_encrypted_b2c_security_credential
MPESA_B2C_RESULT_URL=https://your-public-https-host.example.com/api/v1/loans/mpesa/b2c/result
MPESA_B2C_TIMEOUT_URL=https://your-public-https-host.example.com/api/v1/loans/mpesa/b2c/timeout
# Separate ResultURL/QueueTimeOutURL for BE-09 merry-go-round payouts.
MPESA_MGR_B2C_RESULT_URL=https://your-public-https-host.example.com/api/v1/cycles/mpesa/b2c/result
MPESA_MGR_B2C_TIMEOUT_URL=https://your-public-https-host.example.com/api/v1/cycles/mpesa/b2c/timeout

# SMS provider:
# - console: logs OTP to server logs (recommended for local dev)
# - africastalking: sends real SMS and requires valid credentials below
SMS_PROVIDER=console
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=replace-with-africas-talking-api-key
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com/version1/messaging


# Event notifications (BE-16)
# console logs push events locally; webhook POSTs JSON to your push gateway.
PUSH_PROVIDER=console
# PUSH_WEBHOOK_URL=https://push-gateway.example.com/notifications
# PUSH_WEBHOOK_SECRET=replace-with-push-gateway-secret
# Required to call POST /api/v1/notifications/dispatch. Keep this private and >=32 chars.
NOTIFICATION_DISPATCH_SECRET=replace-with-a-long-random-internal-secret

# Private object storage + malware scanning (BE-22)
# Upload objects remain private; the API issues short-lived SigV4 URLs only after authorization.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=mduara-private-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
# OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
UPLOAD_SIGNED_URL_TTL_SECONDS=900
DOWNLOAD_SIGNED_URL_TTL_SECONDS=300
# Internal scanner polling/callback credential; required when OBJECT_STORAGE_ENABLED=true.
MALWARE_SCAN_SECRET=replace-with-a-long-random-malware-scan-secret

# Background worker (run separately with npm run worker after building)
SCHEDULER_TIMEZONE=Africa/Nairobi
WORKER_DB_POOL_MAX=2
WORKER_BATCH_SIZE=100
REMINDER_CHANNELS=sms,email

# Email reminders: console for development; smtp for real delivery
EMAIL_PROVIDER=console
# EMAIL_FROM=reminders@example.com
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MPESA_STK_ENABLED=false
# Comma-separated callback source IPs. In production configure this and/or the HMAC secret below.
MPESA_CALLBACK_ALLOWED_IPS=
# Optional reverse-proxy callback HMAC; when configured callbacks must send x-mduara-signature=sha256=<hex>.
MPESA_WEBHOOK_HMAC_SECRET=
MPESA_REQUEST_TIMEOUT_MS=15000
