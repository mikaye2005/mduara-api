{
  "name": "mduara-api",
  "version": "1.0.0",
  "private": true,
  "description": "M-Duara chama platform API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node-pg-migrate up -m migrations -j js --ignore-pattern .*\\.sql",
    "db:seed:dev": "tsx src/db/development-seed.ts",
    "test": "node --import tsx --import ./src/tests/setup.ts --test src/tests/unit/**/*.test.ts",
    "test:integration": "node --import tsx --import ./src/tests/setup.ts --test src/tests/integration/**/*.test.ts",
    "db:rollback": "node-pg-migrate down -m migrations -j js --ignore-pattern .*\\.sql",
    "test:integration:required": "node --import tsx --import ./src/tests/setup.ts --import ./src/tests/require-test-database.ts --test src/tests/integration/**/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run test:integration:required && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^7.6.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}